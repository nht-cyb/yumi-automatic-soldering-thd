	VAR robtarget temp;
    
    PROC MoveUpDown (robtarget currentPos)
        temp := currentPos;
        temp.trans.z := temp.trans.z + 4;
        MoveL temp, v10, fine, tool0;
        WaitTime 0.5;
        MoveL currentPos, v10, fine, tool0;
        WaitTime 1;
        MoveL temp, v10, fine, tool0;
        WaitTime 0.2;
    ENDPROC
    
